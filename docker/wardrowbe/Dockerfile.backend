FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev && \
    rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements.txt requirements-extras.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-extras.txt

FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libpq5 curl gosu && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

ARG BG_REMOVAL_MODEL=u2net
ENV REMBG_HOME=/opt/rembg \
    NUMBA_CACHE_DIR=/opt/numba_cache \
    NUMBA_CPU_NAME=generic
RUN python -c "from rembg import new_session; new_session('$BG_REMOVAL_MODEL')" \
    && mv /opt/rembg/models /opt/rembg/baked \
    && mkdir -m 1777 /opt/rembg/models \
    && ln -s /opt/rembg/baked/* /opt/rembg/models/ \
    && chmod -R a+rX /opt/rembg/baked \
    && chmod -R a+rwX /opt/numba_cache

WORKDIR /app
COPY app ./app
COPY migrations ./migrations
COPY alembic.ini ./
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app && \
    mkdir -p /data/wardrobe /data/uploads && chown -R appuser:appuser /data
COPY --chmod=755 docker-entrypoint.sh /docker-entrypoint.sh
ENTRYPOINT ["/docker-entrypoint.sh"]
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
