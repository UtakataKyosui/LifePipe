# このファイルを .env にコピーして値を埋める。 .env は git 管理しない。
# 生成例: openssl rand -hex 24
# DSN の URL に埋め込むため、パスワードは英数字（hex）にすること。

# --- 共有 Postgres ---
POSTGRES_PASSWORD=
HOMEBOX_DB_PASSWORD=
MEMOS_DB_PASSWORD=
VIKUNJA_DB_PASSWORD=
WARDROWBE_DB_PASSWORD=

# --- Homebox ---
HOMEBOX_API_KEY_PEPPER=
HOMEBOX_PORT=3100

# --- Memos ---
MEMOS_PORT=5230

# --- Vikunja ---
VIKUNJA_JWT_SECRET=
VIKUNJA_PORT=3456

# --- Grocy ---
GROCY_PORT=8081

# --- Wallos ---
WALLOS_PORT=8282
TZ=Asia/Tokyo

# --- Wardrowbe ---
WARDROWBE_PORT=8080
WARDROWBE_SECRET_KEY=
WARDROWBE_NEXTAUTH_SECRET=
# true の間は OIDC なしの開発用ログインが有効になる（ローカル専用）。公開する場合は OIDC を設定して false にする。
WARDROWBE_DEBUG=true
# AI の接続先（既定はホスト上の Ollama）。
WARDROWBE_AI_BASE_URL=http://host.docker.internal:11434/v1
WARDROWBE_AI_API_KEY=
WARDROWBE_AI_VISION_MODEL=llava
WARDROWBE_AI_TEXT_MODEL=llama3
