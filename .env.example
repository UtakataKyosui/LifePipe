# このファイルを .env にコピーして値を埋める。 .env は git 管理しない。
# 生成例: openssl rand -hex 24
# DSN の URL に埋め込むため、パスワードは英数字（hex）にすること。

# --- 共有 Postgres ---
POSTGRES_PASSWORD=
HOMEBOX_DB_PASSWORD=
MEMOS_DB_PASSWORD=
VIKUNJA_DB_PASSWORD=
WARDROWBE_DB_PASSWORD=

# --- Homebox ---
HOMEBOX_API_KEY_PEPPER=
HOMEBOX_PORT=3100

# --- Memos ---
MEMOS_PORT=5230

# --- Vikunja ---
VIKUNJA_JWT_SECRET=
VIKUNJA_PORT=3456
